# CentroGoma — plantilla de .env
# Producción: centrogoma.rdbti.com (VPS Vultr). Ver docs/DESPLIEGUE_VPS.md.
# Las contraseñas NUNCA se versionan: van solo en el .env del entorno.

APP_NAME="Centro Goma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://centrogoma.rdbti.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# BD de la app
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=centrogoma
DB_USERNAME=centrogoma
DB_PASSWORD=

# BD legacy Delphi (centro_goma), solo lectura. Se usa únicamente para importar
# (centrogoma:importar / centrogoma:importar-saldos).
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=centro_goma
LEGACY_DB_USERNAME=centrogoma_legacy_ro
LEGACY_DB_PASSWORD=

# Administrador inicial (lo crea RolesAndPermissionsSeeder; sin estos valores no crea ninguno)
CENTROGOMA_ADMIN_EMAIL=
CENTROGOMA_ADMIN_PASSWORD=
CENTROGOMA_ADMIN_NAME="Administrador"

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@rdbti.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
